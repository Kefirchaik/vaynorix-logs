# Copy these to Vercel → Project → Settings → Environment Variables.
# Existing MAZE Hosting game database, same EXISTING DB user only.
DB_HOST=YOUR_MARIADB_HOST
DB_PORT=3306
DB_NAME=gs325627
DB_USER=gs325627
DB_PASSWORD=YOUR_EXISTING_DATABASE_PASSWORD
DB_SSL=false
SESSION_SECRET=GENERATE_RANDOM_64_HEX_CHARACTERS

# Set just for initial Owner login, then remove BOTH after Owner was created in MariaDB.
OWNER_USERNAME=Owner
OWNER_PASSWORD=SET_STRONG_PASSWORD_12_OR_MORE_CHARS